 SG_ EngineRPM : 16|16@1+ (1,0) [800|5000] "rpm" CANAnalyzer

BO_ 257 VehicleStatus2: 8 VehicleController
 SG_ CoolantTemperature : 0|8@1+ (1,-40) [20|120] "degC" CANAnalyzer
 SG_ FuelLevel : 8|8@1+ (0.5,0) [0|100] "%" CANAnalyzer

BO_ 258 BatteryStatus: 8 VehicleController
 SG_ BatteryVoltage : 0|16@1+ (0.01,0) [11|15] "V" CANAnalyzer

BO_ 259 AmbientStatus: 8 VehicleController
 SG_ AmbientTemperature : 0|8@1- (1,-40) [-20|60] "degC" CANAnalyzer

CM_ BO_ 259 "Ambient temperature information.";
